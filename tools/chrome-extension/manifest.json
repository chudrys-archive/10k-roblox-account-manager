{
  "manifest_version": 3,
  "name": "Isa Roblox Account Manager Capture",
  "version": "1.0.0",
  "description": "Hands the Roblox login cookie to your local Isa Roblox Account Manager while it is waiting for a login.",
  "key": "",
  "permissions": ["cookies", "nativeMessaging", "alarms"],
  "host_permissions": ["https://www.roblox.com/*"],
  "background": { "service_worker": "background.js" }
}